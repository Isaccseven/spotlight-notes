{
  "name": "spotlight-notes",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A macOS menu-bar quick-note app with Spotlight-like overlay and scheduled reminders",
  "author": "Isaccseven",
  "license": "MIT",
  "keywords": [
    "notes",
    "macos",
    "tauri",
    "quick-note",
    "spotlight",
    "menu-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Isaccseven/spotlight-notes.git"
  },
  "bugs": {
    "url": "https://github.com/Isaccseven/spotlight-notes/issues"
  },
  "homepage": "https://github.com/Isaccseven/spotlight-notes#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "prepare": "simple-git-hooks",
    "commitlint": "commitlint --edit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "simple-git-hooks": {
    "commit-msg": "npx --no-install commitlint --edit $1"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-global-shortcut": "~2",
    "@tauri-apps/plugin-log": "~2",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-store": "~2",
    "react": "^19.1.0",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^4.1.6",
    "jsdom": "^29.1.1",
    "semantic-release": "^25.0.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.6"
  }
}
